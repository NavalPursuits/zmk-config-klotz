#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define NUM   3
#define FKEY  4
#define GAME1  5
#define GAME2 6

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tvp {
            timeout-ms = <100>;
            key-positions = <11 12 13>;
            bindings = <&tog 0>;
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };

        slm: sticky_layer_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&sl>;

            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        qusp: qusp {
            label = "quote space";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp DQT>, <&macro_tap>, <&kp SPACE>;
        };

        sqsp: sqsp {
            label = "quote space";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp SQT>, <&macro_tap>, <&kp SPACE>;
        };
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            label = "BASE";
            bindings = <
&kp Q        &kp W        &kp F       &kp P        &kp B      &kp J      &kp L       &kp U       &kp Y        &kp TAB
&mt LSHFT A  &mt LCTRL R  &mt LALT S  &mt LGUI T   &kp G      &kp M      &mt RGUI N  &mt RALT E  &mt RCTRL I  &mt LSHFT O
&kp Z        &kp X        &kp C       &kp D        &kp V      &kp K      &kp H       &kp COMMA   &kp DOT      &kp FSLH
                                      &lt 4 SPACE  &lt 1 DEL  &lt 3 RET  &lt 2 BSPC
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        NAV {
            label = "NAVI";
            bindings = <
&none      &none      &none         &none     &none     &none      &kp CAPS        &kp INSERT      &msc SCRL_UP  &none
&kp LSHFT  &kp LCTRL  &kp LEFT_ALT  &kp LGUI  &none     &kp PG_UP  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT     &kp RIGHT
&none      &none      &none         &none     &none     &kp PG_DN  &caps_word      &kp PSCRN       &msc SCRL_UP  &none
                                    &trans    &trans    &kp ESC    &kp F2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        SYM {
            label = "SYM";
            bindings = <
&kp DQT    &kp BSLH  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE2    &none  &none       &none       &none      &none
&kp COLON  &kp SEMI  &kp AT                &kp SQT                &kp EXCL     &none  &kp LS(N3)  &kp DOLLAR  &kp GRAVE  &kp LS(NUHS)
&kp LBKT   &kp RBKT  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AMPS     &none  &kp TILDE   &none       &none      &none
                                           &kp STAR               &kp CARET    &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        NUM {
            label = "NUM";
            bindings = <
&trans     &trans     &trans    &trans    &trans  &kp LS(PRCNT)  &kp N7  &kp N8  &kp N9  &kp LS(PLUS)
&kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans  &kp EQUAL      &kp N4  &kp N5  &kp N6  &kp MINUS
&trans     &trans     &trans    &trans    &trans  &kp LS(UNDER)  &kp N1  &kp N2  &kp N3  &kp N0
                                &trans    &trans  &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        FKEY {
            label = "FKEY";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &bt BT_NXT   &none   &none     &bootloader    &sys_reset &out OUT_TOG
&kp F6   &kp F7   &kp F8   &kp F9   &bt BT_PRV   &none   &kp RGUI  &kp RALT  &kp RCTRL  &kp RSHFT
&kp F11  &kp F12  &kp F13  &kp F14  &bt BT_CLR   &none   &none     &none     &none      &none      
                           &none    &none        &none   &none     
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        GAME1 {
            label = "GAME1";
            bindings = <
&kp TAB    &kp Q  &kp W    &kp E      &kp R           &kp T       &kp Y    &kp U   &kp I      &kp O
&kp LSHFT  &kp A  &kp S    &kp D      &kp F           &kp G       &kp H    &kp J   &kp K      &kp L
&kp LCTRL  &kp Z  &kp X    &kp C      &kp V           &kp B       &kp N    &kp M   &kp COMMA  &kp DOT
                           &kp SPACE  &slm 6 6        &kp ENTER   &kp BSPC  
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        GAME2 {
            label = "GAME2";
            bindings = <
&kp M   &kp I   &kp T   &kp G    &kp B      &none  &none  &none  &none  &to 0
&kp N1  &kp N2  &kp N3  &kp N4   &kp N5     &none  &none  &none  &none  &none
&kp N6  &kp N7  &kp N8  &kp N9   &kp N0     &none  &none  &none  &none  &none  
                        &kp ESC  &none      &none  &none  
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

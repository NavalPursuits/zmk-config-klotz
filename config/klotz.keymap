#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define NUM   3
#define FKEY  4
#define GAME  5
#define GAME2 6

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tvp {
            timeout-ms = <100>;
            key-positions = <11 12 13>;
            bindings = <&tog 0>;
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };

        slm: sticky_layer_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&sl>;

            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        qusp: qusp {
            label = "quote space";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp DQT>, <&macro_tap>, <&kp SPACE>;
        };

        sqsp: sqsp {
            label = "quote space";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp SQT>, <&macro_tap>, <&kp SPACE>;
        };
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp Q        &kp W        &kp F       &kp P        &kp B      &kp J      &kp L       &kp U       &kp Y        &kp TAB
&mt LSHFT A  &mt LCTRL R  &mt LALT S  &mt LGUI T   &kp G      &kp M      &mt RGUI N  &mt RALT E  &mt RCTRL I  &mt LSHFT O
&kp Z        &kp X        &kp C       &kp D        &kp V      &kp K      &kp H       &kp COMMA   &kp DOT      &kp FSLH
                                      &lt 3 SPACE  &lt 1 DEL  &lt 4 RET  &lt 2 BSPC
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            label = "NAVI";
            bindings = <
&none      &none      &none         &none     &none      &none      &kp CAPS        &kp INSERT      &msc SCRL_UP  &none
&kp LSHFT  &kp LCTRL  &kp LEFT_ALT  &kp LGUI  &none      &kp PG_UP  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT     &kp RIGHT
&none      &none      &none         &none     &none      &kp PG_DN  &caps_word      &kp PSCRN       &msc SCRL_UP  &none
                                    &trans    &trans     &kp ESC    &kp F2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sim_layer {
            label = "SYM";
            bindings = <
&kp DQT      &kp BSLH      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE2        &none  &none       &none       &none      &none
&kp COLON    &kp SEMI      &kp AT                &kp SQT                &kp EXCL         &none  &kp LS(N3)  &kp DOLLAR  &kp GRAVE  &kp LS(NUHS)
&kp LBKT     &kp RBKT      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AMPS         &none  &kp TILDE   &none       &none      &none
                                                 &kp STAR               &kp CARET        &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            label = "ADJ";
            bindings = <
&sys_reset   &bt BT_CLR  &out OUT_TOG  &trans  &trans  &trans  &kp F7  &kp F8  &kp F9  &kp F12
&bootloader  &bt BT_NXT  &trans        &trans  &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans       &bt BT_PRV  &trans        &trans  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10
                                       &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
